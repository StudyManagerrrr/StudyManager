# TiDB Cloud (URL must be kept private; enable TLS certificate and hostname checks)
APP_ENV=development
DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@HOST:4000/ai_learning_guardian?ssl_verify_cert=true&ssl_verify_identity=true

# Gemini API through Google's OpenAI-compatible endpoint
AI_PROVIDER=gemini
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-4-hydrogen

# Local application options
HOST=127.0.0.1
PORT=8765
LOG_LEVEL=INFO

# Required in deployed environments; generate a unique value of at least 32 characters
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
